# Maintainer: M44F4
# Blobble from its release .deb, the way Omarchy (Arch) installs it: `yay -S blobble-bin`.
# The app puts its own bar widget in ~/.config/omarchy/plugins the first time it runs.
pkgname=blobble-bin
_name=blobble
pkgver=0.1.2
pkgrel=1
pkgdesc="A cozy little companion made from your name: a blob in your tray, bar or desktop"
arch=('x86_64')
url="https://github.com/M44F4/blobble"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'gtk-layer-shell')
optdepends=('pipewire: the mic and camera dot'
            'ffmpeg: turn a dropped video into a GIF')
options=('!strip' '!debug')
provides=("$_name")
conflicts=("$_name")
source=("$_name-$pkgver.deb::$url/releases/download/v$pkgver/Blobble_${pkgver}_amd64.deb"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/M44F4/blobble/v$pkgver/LICENSE"
        "THIRD_PARTY_NOTICES-$pkgver.md::https://raw.githubusercontent.com/M44F4/blobble/v$pkgver/THIRD_PARTY_NOTICES.md")
sha256sums=('285b500dc93ff28273eba193db325cc484a64af5cd3108cf168b4999c60d6954'
            'SKIP'
            'SKIP')
noextract=("$_name-$pkgver.deb")

package() {
  bsdtar -xOf "$_name-$pkgver.deb" data.tar.gz | bsdtar -xf - -C "$pkgdir"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "THIRD_PARTY_NOTICES-$pkgver.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
